item.get('id')} {item.get('action')}", flush=True)
        print("onboard-ok" if report.get("ok") else "onboard-fail", flush=True)
        return 0 if report.get("ok") else 1

    if args.windows_smoke:
        from src.services.desktop_status import windows_smoke_packet, write_windows_smoke_report

        report = windows_smoke_packet()
        path = write_windows_smoke_report(report)
        print(f"windows-smoke-report {path}", flush=True)
        print(f"next {report.get('next')}", flush=True)
        print(report.get("hint") or "", flush=True)
        print(f"platform {report.get('platform')}", flush=True)
        print(f"windows_host {report.get('windows_host')}", flush=True)
        print(f"accepted {report.get('windows_accepted')}", flush=True)
        print(f"smoke_passed {report.get('smoke_passed')}", flush=True)
        print(f"exit_met {report.get('exit_met')}", flush=True)
        for item in report.get("checklist") or []:
            print(f"check {item}", flush=True)
        print("windows-smoke-ok" if report.get("ok") else "windows-smoke-fail", flush=True)
        return 0 if report.get("ok") else 1

    if args.gate:
        from src.services.desktop_status import desktop_status, write_gate_report

        report = desktop_status()
        path = write_gate_report(report)
        print(f"gate-report {path}", flush=True)
        print(f"next {report.get('next')}", flush=True)
        print(report.get("hint") or "", flush=True)
        print(f"platform {report.get('platform')}", flush=True)
        print(f"windows_host {report.get('windows_host')}", flush=True)
        print(f"accepted {report.get('windows_accepted')}", flush=True)
        print(f"exit_met {report.get('exit_met')}", flush=True)
        for item in report.get("remaining") or []:
            print(f"remaining {item}", flush=True)
        print("gate-ok" if report.get("ok") else "gate-fail", flush=True)
        return 0 if report.get("ok") else 1

    if args.closeout:
        report = closeout_packet(args.host, args.port)
        path = write_closeout_report(report)
        print(f"closeout-report {path}", flush=True)
        print(f"next {report.get('next')}", flush=True)
        print(report.get("hint") or "", flush=True)
        print(f"platform {report.get('platform')}", flush=True)
        print(f"windows_host {report.get('windows_host')}", flush=True)
        print(f"accepted {report.get('accepted')}", flush=True)
        print(f"exit_met {report.get('exit_met')}", flush=True)
        for item in report.get("remaining") or []:
            print(f"remaining {item}", flush=True)
        print("closeout-ok" if report["ok"] else "closeout-fail", flush=True)
        return 0 if report["ok"] else 1
