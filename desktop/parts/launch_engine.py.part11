    args = parser.parse_args()

    if str(ROOT) not in sys.path:
        sys.path.insert(0, str(ROOT))

    if args.ci_apply:
        from src.services.desktop_status import ci_apply_packet, write_ci_apply_report

        report = ci_apply_packet()
        path = write_ci_apply_report(report)
        print(f"ci-apply-report {path}", flush=True)
        print(f"target {report.get('target_dir')}", flush=True)
        print(f"has_setup {report.get('has_setup')}", flush=True)
        print(f"has_portable {report.get('has_portable')}", flush=True)
        print(f"complete {report.get('complete')}", flush=True)
        print(f"windows_host {report.get('windows_host')}", flush=True)
        print(f"windows_accepted {report.get('windows_accepted')}", flush=True)
        print(f"exit_met {report.get('exit_met')}", flush=True)
        print(f"next {report.get('next')}", flush=True)
        for item in report.get("commands") or []:
            print(f"cmd {item}", flush=True)
        print("ci-apply-ok" if report.get("ok") else "ci-apply-fail", flush=True)
        raise SystemExit(0 if report.get("ok") else 1)

    if args.ci_finish:
