def closeout_packet(host: str, preferred: int) -> dict:
    packet = operator_packet(host, preferred)
    platform = sys.platform
    windows_host = platform.startswith("win")
    stamp = packet.get("stamp") or windows_accepted()
    remaining = []
    if not windows_host:
        remaining.append("this host is not Windows; Setup.exe / double-click path still open")
    if not stamp.get("ok"):
        remaining.append("windows_accepted.json missing — run Accept-AgentForge.bat after /ui")
    if not packet.get("exit_met"):
        remaining.append("signoff exit_met is false until pack + nsi + Windows stamp all pass")
    remaining.append("trigger windows-setup.yml if Setup.exe or portable zip is missing")
    return {
        "ok": bool(packet.get("ok")),
        "exit_met": bool(packet.get("exit_met")) and windows_host,
        "accepted": bool(packet.get("accepted")),
        "windows_host": windows_host,
        "platform": platform,
        "product": "AgentForge",
        "version": packet.get("version"),
        "workflow": packet.get("workflow"),
        "silent": packet.get("silent"),
        "ui": packet.get("ui"),
        "healthy": packet.get("healthy"),
        "artifacts": packet.get("artifacts", []),
        "remaining": remaining,
        "next": "Windows closeout: CI artifact → FirstRun → /ui → Accept → Signoff",
        "hint": "Closeout records host OS. Linux CI cannot close Phase 4.",
        "criteria": packet.get("criteria", []),
        "steps": packet.get("steps", []),
        "stamp": stamp,
    }


